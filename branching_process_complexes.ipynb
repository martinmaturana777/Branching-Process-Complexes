    "cx3 = build_cubical_complex((6, 6, 6))\n",
    "print(f\"Caja 6x6x6: V={len(cx3.vertices)}, E={len(cx3.edges)}, F={len(cx3.faces)}   \"\n",
    "      f\"|∂_1∂_2| = {chain_complex_defect(cx3.d1, cx3.d2)}   λ_e en el bulk = {edge_face_counts(cx3.d2).max()}\")\n",
    "\n",
    "rng3 = np.random.default_rng(SEED)\n",
    "T3 = kill_mask_for_mode(cx3, \"tree\", rng3)\n",
    "print(\"árbol generador:\", is_spanning_tree(T3, cx3.d1), f\"  |T|/|E| = {T3.mean():.2f}\")\n",
    "\n",
    "res3 = run_branching_process(random_configuration(cx3, 30, rng3, support=central_edges(cx3, 1.5)),\n",
    "                             20_000, cx3, T3, random_seed=SEED)\n",
    "st3, H3, Th3 = reconstruct_trajectory(res3, n_frames=res3.n_steps + 1)\n",
    "print(f\"eventos: {res3.n_steps}   extinto: {res3.extinct}\")\n",
    "print(\"θ reconstruido == θ del motor                :\", np.array_equal(Th3[-1], res3.theta_final))\n",
    "print(\"Δ‖θ‖_1 = (4 - k) - 2a en cada paso          :\",\n",
    "      np.array_equal(np.diff(res3.log.l1), 4 - res3.log.kills - 2 * res3.log.annihilations))\n",
    "\n",
    "lhs3 = np.array([generator_of_squared_norm(th, res3.B, cx3.d2) for th in Th3])\n",
    "rhs3 = np.array([strong_lyapunov_bound(th, cx3.d2, cx3.dim) for th in Th3])\n",
    "print(\"Lyapunov fuerte con C_3 = 16 en todo t      :\", np.all(lhs3 <= rhs3))\n",
    "\n",
    "th_t = Th3[min(20, res3.n_steps)]\n",
    "ex3 = generator_drift(th_t, res3.B)\n",
