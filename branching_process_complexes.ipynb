    "def describe_chain(column, cells, scale=0.5):\n",
    "    \"\"\"Texto legible '±1·(baricentro)' de una cadena dada como columna rala.\"\"\"\n",
    "    col = column.tocoo()\n",
    "    return \"  \".join(f\"{int(v):+d}·{tuple((cells[r] * scale).tolist())}\" for r, v in zip(col.row, col.data))\n",
    "\n",
    "\n",
    "cx_small = build_cubical_complex((3, 3))\n",
    "print(f\"Caja 3x3: V={len(cx_small.vertices)}, E={len(cx_small.edges)}, F={len(cx_small.faces)}\")\n",
    "\n",
    "face_idx = lookup_cells([[1, 1]], build_cell_lookup(cx_small.faces, (3, 3)), (3, 3))[0]\n",
    "print(\"∂_2 (1/2, 1/2) =\", describe_chain(cx_small.d2[:, face_idx], cx_small.edges))\n",
    "\n",
    "edge_idx = lookup_cells([[3, 4]], build_cell_lookup(cx_small.edges, (3, 3)), (3, 3))[0]\n",
    "print(\"∂_1 (3/2, 2)   =\", describe_chain(cx_small.d1[:, edge_idx], cx_small.vertices))\n",
    "\n",
    "print(\"\\n|∂_1 ∂_2| max en Z^2:\", chain_complex_defect(cx_small.d1, cx_small.d2))\n",
    "\n",
    "# Para comprobar que los signos ε_J funcionan en cualquier dimensión, usamos Z^3 con ∂_3.\n",
    "shape3 = (3, 3, 3)\n",
    "E3, F3, C3 = build_edges(shape3), build_faces(shape3), cells_of_dimension(shape3, 3)\n",
    "d1_3, d2_3, d3_3 = boundary_1(build_vertices(shape3), E3, shape3), boundary_2(E3, F3, shape3), boundary_matrix(C3, F3, shape3)\n",
    "print(\"|∂_1 ∂_2| max en Z^3:\", chain_complex_defect(d1_3, d2_3), \"  |∂_2 ∂_3| max en Z^3:\", chain_complex_defect(d2_3, d3_3))"
