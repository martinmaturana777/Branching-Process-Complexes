    "def restricted_upper_laplacian(d2, kill_mask):\n",
    "    \"\"\"Δ^↑ restringido a las 1-formas que se anulan en T: (∂_2 ∂_2^T)[E∖T, E∖T].\"\"\"\n",
    "    keep = ~kill_mask\n",
    "    return upper_laplacian(d2[keep])\n",
    "\n",
    "\n",
    "def poincare_constant(d2, kill_mask, tol=1e-9):\n",
    "    \"\"\"(c', dim ker): menor autovalor de Δ^↑|_{E∖T} y dimensión de su núcleo (denso; solo para cajas chicas).\"\"\"\n",
    "    ev = np.linalg.eigvalsh(restricted_upper_laplacian(d2, kill_mask).toarray().astype(float))\n",
    "    return ev[0], int(np.sum(ev < tol))\n",
    "\n",
    "\n",
    "def divergence(theta, d1):\n",
    "    \"\"\"∂_1 θ: carga neta en cada vértice (ver §4).\"\"\"\n",
    "    return d1 @ theta\n",
    "\n",
    "\n",
    "cx_p = build_cubical_complex((8, 8))\n",
    "for mode in [\"tree\", \"box_boundary\", \"none\"]:\n",
    "    c_p, k = poincare_constant(cx_p.d2, kill_mask_for_mode(cx_p, mode, np.random.default_rng(3)))\n",
    "    print(f\"T = {mode:13s}  c' = {max(c_p, 0):.4f}   dim ker Δ↑|_(E∖T) = {k}\")\n",
    "print(\"vértices interiores de la caja 8x8:\", 7 * 7)\n",
    "\n",
    "# Conservación de ∂_1 θ en los vértices interiores con killing en el borde de la caja, y su ruptura con killing en un árbol.\n",
    "interior = np.all((cx.vertices > 0) & (cx.vertices < 2 * np.array(cx.box_shape)), axis=1)\n",
    "masks = {\"box_boundary\": kill_mask_for_mode(cx, \"box_boundary\"), \"tree\": T_tree}\n",
    "free = ~(masks[\"box_boundary\"] | T_tree)\n",
    "e_start = central_edges(cx, 2)[free[central_edges(cx, 2)]][0]  # arista central fuera de ambos T\n",
