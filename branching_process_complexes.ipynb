    "print(f\"dim ker Δ_1^↑ = {np.sum(np.linalg.eigvalsh(L_up.toarray().astype(float)) < 1e-9)} = |V|-1 = {len(cx_lap.vertices) - 1}  (formas exactas ∇g)\")"
