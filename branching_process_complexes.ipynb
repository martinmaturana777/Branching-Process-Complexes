    "### Drift: $\\mathcal{L}I(\\theta)=-\\Delta^{\\uparrow}\\theta$\n",
    "\n",
    "Con killing el drift es $-\\partial_T\\partial_T^{T}\\theta$. Para comprobarlo, estimamos el drift con Monte Carlo totalmente vectorizado: muestreamos $N$ saltos desde un mismo $\\theta$, de modo que $\\widehat{\\mathcal{L}I}=q(\\theta)\\cdot\\overline{\\text{incremento}}$, y lo comparamos con la fórmula cerrada."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "533ee19a",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-10-02T01:34:08.452869Z",
     "iopub.status.busy": "2026-10-02T01:34:08.452810Z",
     "iopub.status.idle": "2026-10-02T01:34:08.473493Z",
     "shell.execute_reply": "2026-10-02T01:34:08.473246Z"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "‖LI exacto‖ = 12.961   ‖MC - exacto‖ = 0.071   (error relativo 0.55%)\n"
     ]
    }
   ],
   "source": [
    "def generator_drift(theta, B):\n",
    "    \"\"\"L I(θ) = -∂_T ∂_T^T θ = -Δ^↑_T θ (§2.1, con co-restricción).\"\"\"\n",
    "    return -(B @ (B.T @ theta))\n",
    "\n",
    "\n",
    "def sample_faces_vectorized(edges, B_csr, rng):\n",
    "    \"\"\"Cara uniforme adyacente a cada arista de `edges` y su incidencia ⟨e, ∂f⟩ (vectorizado).\"\"\"\n",
    "    counts = np.diff(B_csr.indptr)[edges]\n",
    "    pos = B_csr.indptr[edges] + (rng.random(len(edges)) * counts).astype(np.int64)\n",
    "    return B_csr.indices[pos], B_csr.data[pos]\n",
    "\n",
    "\n",
    "def monte_carlo_drift(theta, B, lam, n_samples, rng):\n",
    "    \"\"\"Estimador de L I(θ) = q(θ) · E[θ' - θ] a partir de n_samples saltos independientes desde θ.\"\"\"\n",
    "    w = np.abs(theta) * lam\n",
    "    total = w.sum()\n",
    "    e = rng.choice(len(theta), size=n_samples, p=w / total)\n",
    "    f, inc = sample_faces_vectorized(e, B, rng)\n",
    "    c = inc * np.sign(theta[e])\n",
    "    return total * (B @ np.bincount(f, weights=-c, minlength=B.shape[1])) / n_samples\n",
    "\n",
    "\n",
    "theta_test = Theta_all[min(30, res.n_steps)]\n",
    "exact = generator_drift(theta_test, res.B)\n",
    "mc = monte_carlo_drift(theta_test, res.B, edge_face_counts(cx.d2), 400_000, np.random.default_rng(1))\n",
    "print(f\"‖LI exacto‖ = {np.linalg.norm(exact):.3f}   ‖MC - exacto‖ = {np.linalg.norm(mc - exact):.3f}\"\n",
    "      f\"   (error relativo {np.linalg.norm(mc - exact) / np.linalg.norm(exact):.2%})\")"
   ]
  },
