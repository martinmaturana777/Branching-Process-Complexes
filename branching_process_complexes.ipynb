    "theta_div[e_start] = 1  # una sola partícula: ∂_1θ_0 = ±1 en sus dos extremos\n",
    "print(\"partícula inicial en\", cx.edges[e_start] / 2)\n",
    "for mode, T in masks.items():\n",
    "    r = run_branching_process(theta_div, 3000, cx, T, random_seed=7)\n",
    "    _, _, Th = reconstruct_trajectory(r, n_frames=100)\n",
    "    div = divergence(Th.T, cx.d1)[interior]\n",
    "    print(f\"{mode:13s}: max_t |∂_1θ_t - ∂_1θ_0| en vértices interiores = {np.abs(div - div[:, :1]).max():3d}\"\n",
    "          f\"   extinto: {r.extinct}  ‖θ_final‖_1 = {r.log.l1[-1]}\")"
