    "def squared_face_norms(B):\n",
    "    \"\"\"s_f = ‖∂_T f‖_2^2 (= 4 si ninguna arista de f está en T).\"\"\"\n",
    "    return np.asarray(B.multiply(B).sum(axis=0)).ravel()\n",
    "\n",
    "\n",
    "def generator_of_squared_norm(theta, B, d2):\n",
    "    \"\"\"L‖θ‖² = |θ|^T |∂_2| s - 2‖∂_T^T θ‖² (fórmula cerrada de la prueba del Teo. 2.1).\"\"\"\n",
    "    return np.abs(theta) @ (abs(d2) @ squared_face_norms(B)) - 2 * np.sum((B.T @ theta) ** 2)\n",
    "\n",
    "\n",
    "def generator_of_squared_norm_bruteforce(theta, B):\n",
    "    \"\"\"L‖θ‖² evaluando φ(θ - c ∂_T f) - φ(θ) en cada par (e, f) con e ∈ ∂f (vectorizado sobre los pares).\"\"\"\n",
    "    pairs = B.tocoo()\n",
    "    c = pairs.data * np.sign(theta[pairs.row])\n",
    "    delta = -2 * c * (B.T @ theta)[pairs.col] + c**2 * squared_face_norms(B)[pairs.col]\n",
    "    return np.sum(np.abs(theta[pairs.row]) * delta)\n",
    "\n",
    "\n",
    "def strong_lyapunov_bound(theta, d2, dim):\n",
    "    \"\"\"C_d ‖θ‖_1 - 2‖∇θ‖_2², con C_d = 8(d-1) y ∇θ = ∂_2^T θ.\"\"\"\n",
    "    return 8 * (dim - 1) * np.abs(theta).sum() - 2 * np.sum((d2.T @ theta) ** 2)\n",
    "\n",
    "\n",
    "lhs = np.array([generator_of_squared_norm(th, res.B, cx.d2) for th in Theta_all])\n",
    "lhs_bf = np.array([generator_of_squared_norm_bruteforce(th, res.B) for th in Theta_all])\n",
    "rhs = np.array([strong_lyapunov_bound(th, cx.d2, cx.dim) for th in Theta_all])\n",
    "print(\"fórmula cerrada == fuerza bruta:\", np.allclose(lhs, lhs_bf), \"   cota L‖θ‖² ≤ C_d‖θ‖₁ - 2‖∇θ‖² en todo t:\", np.all(lhs <= rhs))\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(8, 3.2))\n",
