    "cx_lap = build_cubical_complex((6, 6))\n",
    "L_down, L_up = lower_laplacian(cx_lap.d1), upper_laplacian(cx_lap.d2)\n",
    "L1 = hodge_laplacian(L_down, L_up)\n",
    "\n",
    "e0 = bulk_edge_index(cx_lap)\n",
    "row = L1[e0].tocoo()\n",
    "print(\"Arista del bulk:\", cx_lap.edges[e0] / 2)\n",
