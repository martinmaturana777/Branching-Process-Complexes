     "iopub.status.idle": "2026-10-02T01:34:30.755675Z",
     "shell.execute_reply": "2026-10-02T01:34:30.755468Z"
    }
   },
   "outputs": [],
   "source": [
    "def replica_seeds(master_seed, n):\n",
    "    \"\"\"Semillas independientes y reproducibles para n réplicas.\"\"\"\n",
    "    return np.random.SeedSequence(master_seed).spawn(n)\n",
    "\n",
    "\n",
    "def extinction_time(theta0, cx, kill_mask, seed, max_steps):\n",
    "    \"\"\"(τ en tiempo continuo, número de eventos, ¿se extinguió?) para una réplica.\"\"\"\n",
    "    r = run_branching_process(theta0, max_steps, cx, kill_mask, random_seed=seed)\n",
    "    return r.log.times[-1], r.n_steps, r.extinct\n",
    "\n",
    "\n",
    "def extinction_experiment(theta0, cx, kill_mask, n_replicas, master_seed, max_steps=200_000):\n",
    "    \"\"\"Arreglo (R, 3) con los tiempos de extinción de R réplicas.\"\"\"\n",
    "    return np.array([extinction_time(theta0, cx, kill_mask, s, max_steps)\n",
    "                     for s in replica_seeds(master_seed, n_replicas)])\n",
    "\n",
    "\n",
    "def empirical_tail(samples):\n",
    "    \"\"\"(t ordenado, P̂(τ > t)).\"\"\"\n",
    "    t = np.sort(samples)\n",
    "    return t, 1.0 - np.arange(1, len(t) + 1) / len(t)"
   ]
  },
